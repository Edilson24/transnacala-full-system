<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Ícone do Ônibus -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_route_icon"
            android:padding="11dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Rota"
                android:src="@drawable/ic_directions_bus"
                app:tint="@android:color/white" />
        </FrameLayout>

        <!-- Informações da Rota -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNomeRota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Baixa → Alta"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTarifaRota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tarifa: 15 MT"
                android:textColor="@color/fare_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Botão Editar (Suave Azul) -->
        <ImageButton
            android:id="@+id/btnEditar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_soft_blue"
            android:contentDescription="Editar Rota"
            android:padding="10dp"
            android:src="@drawable/ic_edit" />

        <!-- Botão Eliminar (Suave Vermelho) -->
        <ImageButton
            android:id="@+id/btnEliminar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_soft_red"
            android:contentDescription="Eliminar Rota"
            android:padding="10dp"
            android:src="@drawable/ic_delete" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>